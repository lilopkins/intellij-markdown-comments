<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>uk.hpkns.markdown-comments</id>
    <name>Markdown Comments</name>
    <vendor url="https://hpkns.uk">Lily Hopkins</vendor>
    <description><![CDATA[
        Render regular code comments as Markdown inline in the editor, similarly to rich KDoc/Javadoc display.
        ]]></description>

    <extensions defaultExtensionNs="com.intellij">
        <editorFactoryListener implementation="uk.hpkns.mdcomments.MarkdownCommentsEditorFactoryListener"/>
    </extensions>

    <actions>
        <action id="uk.hpkns.mdcomments.ToggleMarkdownCommentsAction"
                class="uk.hpkns.mdcomments.ToggleMarkdownCommentsAction"
                text="Render Comments as Markdown"
                description="Toggle inline markdown rendering for regular code comments">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ViewMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
